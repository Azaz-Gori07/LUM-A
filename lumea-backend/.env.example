
# ── LUMÉA API ──────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# JSON store location (created automatically, gitignored)
DATA_DIR=./data

# REQUIRED in production — long random string
JWT_SECRET=

# Session lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Origins allowed to call the API with credentials (comma-separated)
# Use * only for credential-free public reads in development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Links inside emails
PUBLIC_BASE_URL=http://localhost:5500

# Checkout: how long a pending order holds its stock (minutes)
RESERVATION_MINUTES=15

# Rate limits (per IP, 15-minute window)
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=20

# Payments — leave both empty to run in SANDBOX mode.
# When STRIPE_SECRET_KEY is set, run: npm i stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: serve the static frontend from this folder
STATIC_DIR=
